{
  "name": "cards-auth",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cards-service/cards-auth",
  "projectType": "application",
  "tags": ["type:service", "lang:go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "go build -o dist/ ./cmd/...",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "go run ./cmd/cards-auth",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "GOWORK=off go tool -modfile=../../../tools/go/go.mod golangci-lint run --config ../../../.golangci.yml ./...",
          "test -z \"$(gofmt -l .)\""
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -race ./...",
        "cwd": "{projectRoot}"
      }
    }
  }
}
