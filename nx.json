{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/go.work"
    ],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/test/**/*"]
  },
  "targetDefaults": {
    "build": { "dependsOn": ["^build"], "inputs": ["production", "^production"], "cache": true },
    "typecheck": { "inputs": ["default", "^production"], "cache": true },
    "lint": { "inputs": ["default"], "cache": true },
    "test": { "inputs": ["default", "^production"], "cache": true },
    "test-integration": { "inputs": ["default", "^production"], "cache": false }
  }
}
