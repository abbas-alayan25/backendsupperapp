{
  "name": "go-common",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/go/common",
  "projectType": "library",
  "tags": ["scope:shared", "lang:go"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "GOWORK=off go tool -modfile=../../../tools/go/go.mod golangci-lint run --config ../../../.golangci.yml ./...",
          "test -z \"$(gofmt -l .)\""
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -race ./...",
        "cwd": "{projectRoot}"
      }
    }
  }
}
