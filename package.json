{
  "name": "@super-app/source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t test-integration",
    "build": "nx run-many -t build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:versions": "node tools/scripts/check-exact-versions.mjs",
    "check:comments": "node tools/scripts/check-no-comments.mjs",
    "dev:up": "docker compose up -d --wait --wait-timeout 600 && nx run dev-seed:seed-vault",
    "dev:down": "docker compose down",
    "dev:smoke": "nx run infra-tests:smoke",
    "db:migrate": "nx run-many -t migrate",
    "dev:seed-vault": "nx run dev-seed:seed-vault",
    "dev:seed": "nx run dev-seed:seed-vault && nx run tenant-service:seed"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.12",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "nx": "23.2.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
